# Photon project credentials (app.photon.codes → project → Settings). Names match PLAN.md §10.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Hidden Rent API (/api, PLAN.md §10). The agent sends links and addresses to its POST /estimate.
API_BASE_URL=http://localhost:8000

# Public URL of the onboarding page (tunnel URL); the QR code points here.
PUBLIC_URL=http://localhost:8787
ONBOARD_PORT=8787

# Mock switches (DEV_STRATEGY #4). Missing Photon credentials also turn these on.
USE_MOCKS=0          # onboarding: skip Photon, redirect to a fake sms: link
AGENT_TERMINAL=0     # agent: chat in the terminal instead of iMessage
USE_MOCK_API=0       # agent: in-process /estimate + /answer with sessions, grades and questions (replies say "demo data")

# Every env name the code reads (PLAN.md §10). Real values only in git-ignored .env files, never committed.
# /agent reads agent/.env (copy agent/.env.example); /api and /model read the process environment.

# /agent (P4): Photon Spectrum project (app.photon.codes → project → Settings)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# /agent: where the Hidden Rent API is (POST /estimate)
API_BASE_URL=http://localhost:8000
# /agent only: onboarding page + mock switches (see agent/.env.example)
PUBLIC_URL=http://localhost:8787
ONBOARD_PORT=8787
USE_MOCKS=0
AGENT_TERMINAL=0

# /api (P2): where P1's heating/cooling server is (make -C model dashboard), and the browser origins of /web
MODEL_BASE_URL=http://localhost:8001
WEB_ORIGINS=http://localhost:3000
# /api: SQLite file for sessions (empty = <repo>/data/sessions.sqlite)
SESSIONS_DB=
# /api: SQLite file for /calibrate bill months and streaks (empty = <repo>/data/calibrate.sqlite)
CALIBRATE_DB=
# /api: SQLite file for Phase 2 records: users, properties, commitments, projections (empty = <repo>/data/app.sqlite)
APP_DB=
# /api and /agent: shared secret the agent sends as X-Agent-Key on agent-only endpoints (unset = open, dev mode).
# /api also reads PHOTON_PROJECT_ID / PHOTON_PROJECT_SECRET / USE_MOCKS (above) for web login by text.
AGENT_API_KEY=
# /api: xAI key and vision model for reading bill photos in /calibrate (typed numbers work without them)
XAI_API_KEY=
XAI_VISION_MODEL=

# /web (P3, Next.js; put in web/.env.local): the API and P4's onboarding page
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ONBOARD_URL=http://localhost:8787

# Not read by any code yet (PLAN.md §10 placeholders)
ELEVENLABS_API_KEY=
DATABASE_URL=

# /api: optional Google Calendar web-server OAuth (empty client ID/secret = labelled demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to http://localhost:8000/calendar/callback; must exactly match the Google web client redirect
GOOGLE_REDIRECT_URI=
# At least 32 characters for real OAuth; generate a private random value outside this file
CALENDAR_STATE_SECRET=
# Callback destination, default http://localhost:3000
WEB_ORIGIN=
